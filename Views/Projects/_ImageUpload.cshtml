<!-- Built partially with help from ChatGPT to follow correct Bootstrap 5 syntax and layout -->

@model WebApp.Models.ProjectCreateFormModel

<div class="image-upload-wrapper mb-4">
    <div class="image-preview-container position-relative"
         style="width: 120px; height: 120px; border: 2px dashed #ccc; border-radius: 1rem; display: flex; align-items: center; justify-content: center;">

        <div id="camera-icon"
             class="position-absolute"
             style="color: #888; font-size: 24px; @(string.IsNullOrWhiteSpace(Model.ExistingIconPath) ? "" : "display:none;")">
            <i class="fa-solid fa-camera"></i>
        </div>

        <img id="image-preview"
             src="@(string.IsNullOrWhiteSpace(Model.ExistingIconPath) ? "" : Model.ExistingIconPath)"
             alt="Preview"
             style="max-width: 100%; max-height: 100%; border-radius: 0.75rem; object-fit: cover;"
             class="@(string.IsNullOrWhiteSpace(Model.ExistingIconPath) ? "d-none" : "")" />

    </div>

    <div class="form-group mt-2">
        <label asp-for="File" class="form-label">Upload Image</label>
        <input asp-for="File" id="File" accept="image/*" class="form-control" />
        <span asp-validation-for="File" class="text-danger"></span>
    </div>
</div>

