@model FileUploadViewModel

@{
	ViewData["Title"] = "File Upload";
}
<link rel="stylesheet" href="~/css/form.css" />
@if (ViewBag.Message != null)
{
	<div class="d-flex flex-column align-items-center mt-4">
		<div class="alert alert-success text-center w-100" style="max-width: 500px">
			@ViewBag.Message
		</div>
		<form method="get" asp-action="Upload" class="w-100" style="max-width: 500px;">
			<button type="submit" class="btn-accent w-100 rounded">Refresh</button>
		</form>
	</div>

}
else
{
	<div class="card shadow rounded-3 p-4" style="max-width: 500px; margin: 0 auto;">
		<h2 class="mb-4">File upload</h2>
		<form asp-action="Upload" method="post" enctype="multipart/form-data">


			<div class="image-preview-container">
				<div class="icon-wrapper" id="camera-icon">
					<i class="fa-solid fa-camera"></i>
				</div>
				<img id="image-preview" src="#" alt="Image Preview" class="d-none" />
			</div>

			

			<div class="form-group mb-3">
				<label asp-for="File" class="form-label"></label>
				<input asp-for="File" accept="image/*" class="form-control">
				<span asp-validation-for="File"></span>

			</div>
			<button type="submit" class="btn-accent w-100">Upload file</button>
		</form>
	</div>
}

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const fileInput = document.querySelector("#File");
		const img = document.querySelector("#image-preview");
		const cameraIcon = document.querySelector("#camera-icon");

		if (!fileInput || !img || !cameraIcon) return;

		fileInput.addEventListener("change", (e) => {
			const file = e.target.files[0];

			if (file) {
				const reader = new FileReader();

				reader.onload = (e) => {
					img.src = e.target.result;
					img.classList.remove("d-none");
					cameraIcon.classList.add("d-none"); // Dölj kameran
				};

				reader.readAsDataURL(file);
			} else {
				img.classList.add("d-none");
				cameraIcon.classList.remove("d-none"); // Visa kameran igen
			}
		});
	});
</script>

