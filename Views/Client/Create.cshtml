@model ClientCreateFormModel

@{
	ViewData["Title"] = "Add Client";
}

<div id="add-client">
	<div class="card shadow rounded-3 p-4" style="max-width: 500px; margin: 0 auto;">
	<form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>


		<header class="d-flex justify-content-between align-items-center mb-4">
			<h3 class="m-0">@ViewData["Title"]</h3>
		</header>

		<div class="image-preview-container mb-4">
			<div class="icon-wrapper" id="camera-icon">
				<i class="fa-solid fa-camera"></i>
			</div>
			<img id="image-preview" src="#" alt="Image Preview" class="d-none" />
		</div>
		<div class="form-group mb-3">
			<label asp-for="ClientName" class="form-label"></label>
			<div class="field-group">
				<input asp-for="ClientName" class="form-control">
				<span asp-validation-for="ClientName"></span>
			</div>
		</div>
		<div class="form-group mb-3">
			<label asp-for="ContactPerson" class="form-label"></label>
			<div class="field-group">
				<input asp-for="ContactPerson" class="form-control" />
				<span asp-validation-for="ContactPerson"></span>
			</div>
		</div>

		<div class="form-group mb-3">
			<label asp-for="Email" class="form-label"></label>
			<div class="field-group">
				<input asp-for="Email" class="form-control" />
				<span asp-validation-for="Email"></span>
			</div>
		</div>

		<div class="form-group mb-3">
			<label asp-for="PhoneNumber" class="form-label"></label>
			<div class="field-group">
				<input asp-for="PhoneNumber" class="form-control" />
				<span asp-validation-for="PhoneNumber"></span>
			</div>
		</div>

		<footer>
			<button type="submit" class="btn-accent">Create</button>
		</footer>

	</form>
</div>
</div>

@await Html.PartialAsync("~/Views/Shared/Partials/_ValidationScript.cshtml")